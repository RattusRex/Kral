# Copy this file to `.env` and fill in all values before running.
# `npm run dev`, `npm run build`, and the FastAPI backend read variables from here automatically.

# PostgreSQL connection string used by the backend.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/EpohaTruda

# Secret key for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Password for the default admin account created on first start.
ADMIN_PASSWORD=CHANGE_ME

# Comma-separated list of allowed browser origins (no trailing slashes).
# Include the frontend origin when it is served from a different host/port than FastAPI.
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=

# Optional: backend origin for Vite dev proxy and production static builds.
# Production builds append `/api` to this value unless VITE_API_BASE_URL is set.
# VITE_API_TARGET=http://127.0.0.1:8000

# Optional: full API base URL for the browser bundle. Use this for non-standard API paths.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: override JWT expiry in minutes (default: 30).
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: set to "true" to enable uvicorn --reload (development only).
# UVICORN_RELOAD=false
