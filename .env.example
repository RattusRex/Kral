# Copy this file to `.env` and fill in all values before running.
# `npm run dev`, `npm run build`, and the FastAPI backend read variables from here automatically.
# `docker compose` also reads this file (for variable substitution in docker-compose.yml).

# PostgreSQL connection string used by the backend.
# For a local (non-Docker) setup this points at your own PostgreSQL server.
# When running via `docker compose`, this value is IGNORED — the backend service
# builds DATABASE_URL from the POSTGRES_* variables below and targets the `db`
# container instead. See the "Docker / docker compose" section at the bottom.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/EpohaTruda

# Secret key for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Password for the default admin account created on first start.
ADMIN_PASSWORD=CHANGE_ME

# Comma-separated list of allowed browser origins (no trailing slashes).
# Include the frontend origin when it is served from a different host/port than FastAPI.
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=

# Optional: backend origin for Vite dev proxy and production static builds.
# Production builds append `/api` to this value unless VITE_API_BASE_URL is set.
# VITE_API_TARGET=http://127.0.0.1:8000

# Optional: full API base URL for the browser bundle. Use this for non-standard API paths.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: override JWT expiry in minutes (default: 30).
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: authentication abuse controls.
# Repeated failed login attempts are tracked by submitted username/email and IP.
# Registration attempts are tracked by IP before password hashing starts.
# AUTH_LOGIN_FAILURE_LIMIT=5
# AUTH_LOGIN_IP_FAILURE_LIMIT=25
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_LOGIN_LOCKOUT_SECONDS=300
# AUTH_REGISTRATION_IP_LIMIT=10
# AUTH_REGISTRATION_WINDOW_SECONDS=3600

# Optional: set to "true" to enable uvicorn --reload (development only).
# UVICORN_RELOAD=false

# ---------------------------------------------------------------------------
# Docker / docker compose
# ---------------------------------------------------------------------------
# Credentials for the bundled PostgreSQL `db` service. The backend container
# assembles DATABASE_URL from these values automatically:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=EpohaTruda

# When using docker compose, set ALLOWED_ORIGINS to the public URL the app is
# served from. For a plain local stack that is the nginx frontend port:
#   ALLOWED_ORIGINS=http://localhost:8080
# For a real deployment list only your domain, e.g. https://kral.example.com

# Optional: number of uvicorn workers in the backend container (default: 2).
# WEB_CONCURRENCY=2

# Optional: Cloudflare Tunnel token, used only by the `tunnel` compose profile
# (`docker compose --profile tunnel up -d`). Create it in the Cloudflare
# Zero Trust dashboard under Networks → Tunnels.
# CLOUDFLARE_TUNNEL_TOKEN=
