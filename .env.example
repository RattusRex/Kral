# Copy this file to `.env` and fill in all values before running.
# `npm run dev` and the FastAPI backend read variables from here automatically.

# PostgreSQL connection string used by the backend.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/EpohaTruda

# Secret key for signing JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Password for the default admin account created on first start.
ADMIN_PASSWORD=CHANGE_ME

# Comma-separated list of allowed CORS origins (no trailing slashes).
# Example: https://yourdomain.com,https://www.yourdomain.com
# Leave empty to block all cross-origin requests.
ALLOWED_ORIGINS=

# Optional: override JWT expiry in minutes (default: 30).
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: set to "true" to enable uvicorn --reload (development only).
# UVICORN_RELOAD=false
