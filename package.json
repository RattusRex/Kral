{
  "name": "epoch-of-catastrophe-assistant",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start:backend": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "react-markdown": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
