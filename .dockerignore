# Version control & CI
.git
.github
.gitignore

# Python runtime artifacts
.venv
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend build artifacts (frontend image rebuilds these itself)
node_modules/
dist/

# Local environment & secrets — never bake these into an image
.env
*.db

# Editor / tooling
.idea/
.vscode/
.playwright-mcp/

# Docs & screenshots are not needed at runtime
docs/
*.md
!README.md

# Placeholder created for PR bootstrap
.gitkeep
